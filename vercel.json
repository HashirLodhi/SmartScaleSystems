{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/api/custom-service", "dest": "/api/custom-service.js" },
    { "src": "/api/lead", "dest": "/api/lead.js" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    {
      "src": "/(assets|project-images)/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(og\\.png|logo-main\\.png|favicon-48x48\\.png)",
      "headers": { "Cache-Control": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400" },
      "continue": true
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "headers": { "Cache-Control": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400" },
      "continue": true
    },
    { "src": "/index(?:\\.html)?/?", "status": 301, "headers": { "Location": "/" } },
    { "src": "/about/?", "status": 301, "headers": { "Location": "/team" } },
    { "src": "/privacy/?", "status": 301, "headers": { "Location": "/privacy-policy" } },
    { "src": "/terms/?", "status": 301, "headers": { "Location": "/terms-of-service" } },
    { "src": "/ai-services-pakistan/?", "status": 301, "headers": { "Location": "/services" } },
    {
      "src": "/service-(ai-model-training|ai-automation|custom-ai-agents|data-analytics|ai-integrations|business-automations|computer-vision|nlp|llm|data-annotation|ai-training-data|custom)\\.html/?",
      "status": 301,
      "headers": { "Location": "/services/$1" }
    },
    {
      "src": "/service-(ai-model-training|ai-automation|custom-ai-agents|data-analytics|ai-integrations|business-automations|computer-vision|nlp|llm|data-annotation|ai-training-data|custom)/?",
      "status": 301,
      "headers": { "Location": "/services/$1" }
    },
    { "src": "/testimonials/?", "dest": "/410.html", "status": 410 },
    {
      "src": "/(services|projects|team|contact|privacy-policy|terms-of-service)/",
      "status": 301,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "/services/(ai-model-training|ai-automation|custom-ai-agents|data-analytics|ai-integrations|business-automations|computer-vision|nlp|llm|data-annotation|ai-training-data|custom)/",
      "status": 301,
      "headers": { "Location": "/services/$1" }
    },
    {
      "src": "/services/(ai-model-training|ai-automation|custom-ai-agents|data-analytics|ai-integrations|business-automations|computer-vision|nlp|llm|data-annotation|ai-training-data|custom)\\.html/?",
      "status": 301,
      "headers": { "Location": "/services/$1" }
    },
    {
      "src": "/(services|projects|team|contact|privacy-policy|terms-of-service)\\.html/?",
      "status": 301,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "/services/(ai-model-training|ai-automation|custom-ai-agents|data-analytics|ai-integrations|business-automations|computer-vision|nlp|llm|data-annotation|ai-training-data|custom)/?",
      "dest": "/services/$1.html"
    },
    {
      "src": "/(services|projects|team|contact|privacy-policy|terms-of-service)/?",
      "dest": "/$1.html"
    },
    { "src": "/projects/custom-ai-agent", "status": 301, "headers": { "Location": "/services/custom-ai-agents" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
